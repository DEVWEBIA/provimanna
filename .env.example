# Copie en .env.local (apps/web, apps/admin). Ne commite jamais les vraies valeurs.

# App
NEXT_PUBLIC_APP_NAME="[Nom de l'appli]"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase (supabase start affiche ces valeurs en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # serveur uniquement (webhooks, imports, cron)

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_MONTHLY=price_           # 4,99 €/mois
STRIPE_PRICE_YEARLY=price_            # 39,99 €/an
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Emails
RESEND_API_KEY=re_
EMAIL_FROM="[Nom de l'appli] <bonjour@example.com>"

# Prix
OPEN_PRICES_API_URL=https://prices.openfoodfacts.org/api/v1
OPEN_FOOD_FACTS_USER_AGENT="[Nom de l'appli]/0.1 (contact@example.com)"

# OCR des tickets (au choix, à trancher au lot 7)
OCR_PROVIDER=google_vision
OCR_API_KEY=

# Suivi
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# Notifications web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
